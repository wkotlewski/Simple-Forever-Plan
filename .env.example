# Leave these empty to run in "this device only" mode (everything is saved in the browser).
# Fill them in to turn on real accounts, family sharing with email/text codes, and the AI story writer.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: lets people choose to keep their plan in their own Google Drive (after agreeing).
# Create an OAuth client ID in Google Cloud — see "Saving to Google Drive" in the README.
VITE_GOOGLE_CLIENT_ID=
